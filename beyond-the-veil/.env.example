# Copy this file to .env.local in this same folder and replace the placeholders.
# VITE_ values are public browser configuration, never server secrets.
# Multiplayer also requires the supplied Supabase migration and private Realtime.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Deferred: configure Turnstile with the Cloudflare account owner before
# public multiplayer testing. The secret key belongs in Supabase, not here.
VITE_TURNSTILE_SITE_KEY=
